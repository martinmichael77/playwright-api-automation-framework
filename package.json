{
  "name": "playwright-api-automation-framework",
  "version": "1.0.0",
  "description": "Production-ready API Test Automation Framework using Playwright",
  "author": "QA Automation Team",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:dev": "cross-env ENV=dev playwright test",
    "test:staging": "cross-env ENV=staging playwright test",
    "test:prod": "cross-env ENV=prod playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:parallel": "playwright test --workers=4",
    "test:debug": "playwright test --debug",
    "report:generate": "playwright test --reporter=allure-playwright",
    "report:open": "allure generate ./allure-results --clean -o ./allure-report && allure open ./allure-report",
    "report:clean": "rimraf ./allure-results ./allure-report",
    "lint": "eslint src --fix",
    "format": "prettier --write 'src/**/*.js'",
    "prebuild": "npm run lint && npm run format"
  },
  "dependencies": {
    "@faker-js/faker": "^8.3.1",
    "@playwright/test": "^1.40.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.6.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "allure-commandline": "^2.25.0",
    "allure-playwright": "^2.13.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5"
  },
  "keywords": [
    "playwright",
    "api-testing",
    "automation",
    "test-framework",
    "allure-reporting"
  ]
}
